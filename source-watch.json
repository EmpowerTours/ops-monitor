{
  "user_agent": "EmpowerTours-source-watch/1.0 (+https://github.com/EmpowerTours/ops-monitor)",
  "timeout_s": 30,
  "per_host_delay_s": 3,
  "host_delay_s": {
    "comtradeapi.un.org": 12
  },
  "workers": 8,
  "run_budget_s": 1800,
  "host_max_per_run_note": "UN Comtrade answers one query per 12 s and Cosecha cites about 240 of them (annual data): 80 per run, least recently read first, so each is read every three days and the run stays short.",
  "host_max_per_run": {
    "comtradeapi.un.org": 80
  },
  "manual_hosts_note": "No answer within 120 s on 3 tries, from GitHub runners (run 44974248996) and from a residential connection (2026-11-22): a manual re-check, not a daily 4-minute wait.",
  "manual_hosts": [
    "micor.agriculture.gov.au",
    "www.adafsa.gov.ae"
  ],
  "archive": {
    "enabled": true,
    "user_agent": "source-watch/1.0",
    "min_interval_s": 21,
    "max_per_run": 30,
    "not_within": "20h",
    "poll_s": 10,
    "poll_rounds": 12
  },
  "apps": [
    {
      "app": "cosecha",
      "manifest": "https://cosecha.empowertours.xyz/.well-known/sources.json",
      "verify": "https://cosecha.empowertours.xyz/internal/sources/verify",
      "token_env": "SOURCE_VERIFY_TOKEN_COSECHA",
      "repo": "EmpowerTours/cosecha",
      "radar_keywords": [],
      "fix": {
        "quotes_path": "internal/sources/quotes.json",
        "base": "main"
      }
    },
    {
      "app": "hunt",
      "manifest": "https://hunt-dubai.empowertours.xyz/.well-known/sources.json",
      "verify": "https://hunt-dubai.empowertours.xyz/internal/sources/verify",
      "token_env": "SOURCE_VERIFY_TOKEN_HUNT",
      "repo": "EmpowerTours/hunt-dubai",
      "radar_keywords": [],
      "fix": {
        "quotes_path": "go/internal/sources/quotes.json",
        "base": "main"
      }
    },
    {
      "app": "trips",
      "manifest": "https://sawweeli.empowertours.xyz/.well-known/sources.json",
      "verify": "https://sawweeli.empowertours.xyz/internal/sources/verify",
      "token_env": "SOURCE_VERIFY_TOKEN_TRIPS",
      "repo": "EmpowerTours/landing-dubai",
      "radar_keywords": []
    },
    {
      "app": "sawweeli-agent",
      "manifest": "https://sawweeli-agent.empowertours.xyz/.well-known/sources.json",
      "verify": "https://sawweeli-agent.empowertours.xyz/internal/sources/verify",
      "token_env": "SOURCE_VERIFY_TOKEN_SAWWEELI_AGENT",
      "repo": "EmpowerTours/sawweeli-agent",
      "radar_keywords": []
    }
  ],
  "radar_feeds": [
    {
      "name": "GDRFA Dubai news",
      "url": "https://www.gdrfad.gov.ae/en/news"
    },
    {
      "name": "MOIAT news",
      "url": "https://moiat.gov.ae/en/media-center/news"
    },
    {
      "name": "MOCCAE news",
      "url": "https://www.moccae.gov.ae/en/media-center/news",
      "note": "list is rendered in the browser: no items read by a plain GET (2026-11-21)"
    },
    {
      "name": "MOCCAE legislation",
      "url": "https://www.moccae.gov.ae/en/legislations",
      "note": "rendered in the browser (2026-11-21)"
    },
    {
      "name": "ICP news",
      "url": "https://icp.gov.ae/en/news/",
      "note": "rendered in the browser (2026-11-21)"
    },
    {
      "name": "Dubai Legislation Portal",
      "url": "https://dlp.dubai.gov.ae/en/",
      "note": "home page lists categories, not new legislation (2026-11-21)"
    },
    {
      "name": "Dubai DET news",
      "url": "https://www.dubaidet.gov.ae/en/news",
      "note": "HTTP 403 to plain GETs (2026-11-21)"
    }
  ]
}
